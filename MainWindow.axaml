<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BoxroomMovieMaker.MainWindow"
        Title="BOXROOM Movie Maker"
        Icon="/Assets/MovieMaker.ico"
        Width="1280" Height="900" MinWidth="900" MinHeight="700"
        Background="#10131A">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#191E29" />
    <SolidColorBrush x:Key="SoftBrush" Color="#242B39" />
    <SolidColorBrush x:Key="AccentBrush" Color="#70D6B2" />
    <SolidColorBrush x:Key="MutedBrush" Color="#94A0B5" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="#151A24" Padding="28,20">
      <Grid ColumnDefinitions="*,Auto,12,Auto">
        <StackPanel>
          <TextBlock Text="BOXROOM MOVIE MAKER" FontSize="27" FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="Prepare videos for BOXROOM and Unity's video player."
                     Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <Border Grid.Column="1" Background="#253C3A" CornerRadius="18" Padding="14,7"
                VerticalAlignment="Center">
          <TextBlock Text="H.264  •  AAC  •  YUV420P" Foreground="#A9EBD4" FontWeight="SemiBold" />
        </Border>
        <Button Grid.Column="3" Content="About &amp; licences" Padding="14,8"
                VerticalAlignment="Center" Click="About_OnClick" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24" ColumnDefinitions="340,16,*">
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
          <TextBlock Text="ADD MOVIES" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />

          <Border Grid.Row="1" x:Name="DropZone" Margin="0,16,0,0" Padding="22" MinHeight="190"
                  Background="#202735" BorderBrush="#527769" BorderThickness="2" CornerRadius="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
              <Border Width="54" Height="54" CornerRadius="27" Background="#2D4B45">
                <TextBlock Text="↓" FontSize="31" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="DROP VIDEOS OR A FOLDER" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="Folders are searched recursively" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="*,10,*" Margin="0,12,0,0">
            <Button Grid.Column="0" Content="Choose videos" Click="ChooseVideos_OnClick" />
            <Button Grid.Column="2" Content="Choose folder" Click="ChooseFolder_OnClick" />
          </Grid>

          <Border Grid.Row="3" Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="14" Margin="0,18,0,0">
            <StackPanel Spacing="7">
              <TextBlock Text="FFMPEG" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock x:Name="FfmpegStatusText" Text="Checking for FFmpeg…" TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}" />
              <Button Content="Choose FFmpeg" HorizontalAlignment="Stretch" Click="ChooseFfmpeg_OnClick" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,18,0,0" Spacing="8">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="Output is saved beside each source as name_BOXROOM.mp4. Original files are never changed." />
            <TextBlock Text="Supported input" FontWeight="SemiBold" />
            <TextBlock Text="MP4, MKV, MOV, AVI, WebM, M4V, MPEG, WMV, FLV, TS and OGV"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="CONVERSION QUEUE" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock x:Name="QueueSummaryText" Text="Drop movies here to begin."
                         Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Clear" Padding="14,7" Click="ClearQueue_OnClick" />
          </Grid>

          <Border Grid.Row="1" Margin="0,16,0,0" Background="#141821" CornerRadius="9">
            <Grid>
              <TextBlock x:Name="EmptyQueueText" Text="No movies in the queue"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="#687386" FontSize="17" />
              <ScrollViewer>
                <ItemsControl x:Name="QueueList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#202735" CornerRadius="8" Padding="14" Margin="10,10,10,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Folder}" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                     FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Expander Grid.Row="2" Header="Conversion log" Margin="0,12,0,0">
            <TextBox x:Name="LogTextBox" Height="110" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas,monospace" FontSize="11" />
          </Expander>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,10,Auto" Margin="0,14,0,0">
            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" IsVisible="False"
                         Height="6" VerticalAlignment="Center" Margin="0,0,18,0" />
            <Button Grid.Column="1" x:Name="CancelButton" Classes="danger" Content="Cancel"
                    IsVisible="False" Click="Cancel_OnClick" />
            <Button Grid.Column="3" x:Name="ConvertButton" Classes="primary" Content="Make BOXROOM ready"
                    Click="Convert_OnClick" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#151A24" Padding="24,12">
      <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" />
    </Border>
  </Grid>
</Window>
