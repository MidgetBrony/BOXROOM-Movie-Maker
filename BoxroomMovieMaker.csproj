<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.3</Version>
    <AssemblyName>BoxroomMovieMaker</AssemblyName>
    <RootNamespace>BoxroomMovieMaker</RootNamespace>
    <Description>Cross-platform BOXROOM movie compatibility converter</Description>
    <ApplicationIcon>Assets\MovieMaker.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <AssemblyName>BOXROOM Movie Maker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\MovieMaker.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" Link="Licences\THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="ThirdParty\FFmpeg\win-x64\ffmpeg.exe" Link="ffmpeg.exe"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="ThirdParty\FFmpeg\win-x64\LICENSE.txt" Link="Licences\FFmpeg-GPLv3.txt"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <None Include="ThirdParty\FFmpeg\linux-x64\ffmpeg" Link="ffmpeg"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="ThirdParty\FFmpeg\linux-x64\LICENSE.txt" Link="Licences\FFmpeg-GPLv3.txt"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RemoveNativeDebugSymbolsFromSingleFilePublish"
          AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true'">
    <Delete Files="$(PublishDir)libHarfBuzzSharp.pdb;$(PublishDir)libSkiaSharp.pdb" />
  </Target>
</Project>
